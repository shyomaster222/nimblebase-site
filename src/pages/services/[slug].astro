---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import PostList from '../../components/PostList.astro';
import Closing from '../../components/Closing.astro';
import { site, services, type Service } from '../../data/site';
import { getPosts } from '../../data/insights';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

interface Props {
  service: Service;
}
const { service: s } = Astro.props;
const related = (await getPosts()).filter((p) => p.data.service === s.id);
const others = services.filter((o) => o.id !== s.id);
const lower = s.name.charAt(0).toLowerCase() + s.name.slice(1);
const inSentence = s.name.startsWith('AI') ? s.name : lower;

const schema = [
  {
    '@type': 'Service',
    name: s.name,
    description: s.line,
    provider: { '@type': 'Organization', name: site.name, url: Astro.site?.href },
    url: new URL(`/services/${s.slug}/`, Astro.site).href,
  },
  {
    '@type': 'FAQPage',
    mainEntity: s.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base title={s.name} description={`${s.line} ${s.firstProject}`} schema={schema}>
  <PageHero title={s.name} lede={s.line} crumbs={[{ label: 'Services', href: '/services/' }, { label: s.name }]}>
    <div class="cta-row">
      <a class="btn" href={`/contact/?need=${s.id}`}>{site.cta}</a>
      <p class="cta-note">{s.timeframe}</p>
    </div>
  </PageHero>

  <section class="band">
    <div class="wrap split">
      <div class="head">
        <h2>Signs this is the one you need</h2>
        <p class="lede">{s.forWho}</p>
      </div>
      <ul class="signs">
        {s.signs.map((sign) => <li>{sign}</li>)}
      </ul>
    </div>
  </section>

  <section class="band gets-band">
    <div class="wrap split">
      <div class="head">
        <h2>What you get</h2>
        <p class="lede">{s.intro}</p>
      </div>
      <div class="detail">
        <ul class="gets">
          {s.youGet.map((g) => <li>{g}</li>)}
        </ul>
        <dl class="facts">
          <div>
            <dt>A good first project</dt>
            <dd>{s.firstProject}</dd>
          </div>
          <div>
            <dt>How long</dt>
            <dd>{s.timeframe}</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section class="band band-mint">
    <div class="wrap">
      <div class="band-head">
        <h2>The first four Fridays</h2>
        <p class="lede">What a first month of {inSentence} looks like. Yours will differ in the details and keep the rhythm.</p>
      </div>
      <ol class="fridays">
        {s.weeks.map((w) => <li>{w}</li>)}
      </ol>
      <p class="more"><a href="/how-we-work/">See how a week runs</a></p>
    </div>
  </section>

  <section class="band">
    <div class="wrap split">
      <h2>Questions about {inSentence}</h2>
      <div class="faq-col">
        <Faq items={s.faqs} />
        <p class="more"><a href="/faq/">Read all questions</a></p>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="band related">
        <div class="wrap">
          <div class="band-head">
            <h2>From our notes</h2>
          </div>
          <PostList posts={related} />
        </div>
      </section>
    )
  }

  <section class="band band-forest">
    <div class="wrap">
      <div class="band-head">
        <h2>The same team also does</h2>
      </div>
      <ul class="others">
        {
          others.map((o) => (
            <li>
              <a href={`/services/${o.slug}/`}>
                <h3>{o.name}</h3>
                <p>{o.line}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Closing />
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .head {
    display: grid;
    gap: 1.25rem;
  }
  .split h2 {
    font-size: var(--t-xl);
    line-height: 1.05;
  }
  .gets-band {
    padding-top: 0;
  }
  .related {
    padding-top: 0;
  }

  .signs {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 2px solid var(--forest);
  }
  .signs li {
    border-top: 2px solid var(--forest);
    padding-block: 1.25rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: var(--t-md);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .detail {
    display: grid;
    gap: 1.5rem;
  }
  .gets {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1.5px solid var(--mint-deep);
  }
  .gets li {
    padding: 0.85rem 0 0.85rem 2rem;
    border-top: 1.5px solid var(--mint-deep);
    position: relative;
  }
  /* Tick built from borders, no icon font. */
  .gets li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 1.2rem;
    width: 0.95rem;
    height: 0.5rem;
    border-left: 3px solid var(--leaf);
    border-bottom: 3px solid var(--leaf);
    transform: rotate(-45deg);
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    background: var(--mint);
    border-radius: var(--r-panel);
    padding: 1.5rem;
  }
  .facts dt {
    font-weight: 600;
  }
  .facts dd {
    margin: 0.25rem 0 0;
    color: var(--forest-soft);
  }

  .fridays {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: fri;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .fridays li {
    counter-increment: fri;
    border-top: 4px solid var(--forest);
    padding-top: 0.9rem;
    font-size: var(--t-md);
    line-height: 1.35;
  }
  .fridays li::before {
    content: 'Friday ' counter(fri);
    display: block;
    width: fit-content;
    margin-bottom: 0.6rem;
    padding: 0.05rem 0.5rem;
    border-radius: 5px;
    background: var(--lime);
    font: 600 0.95rem var(--display);
  }
  .more {
    margin-top: 2rem;
    font-family: var(--display);
    font-weight: 600;
  }
  .faq-col .more {
    margin-top: 1.5rem;
  }

  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .others a {
    display: grid;
    gap: 0.6rem;
    border-top: 2px solid var(--mint);
    padding-top: 1.25rem;
    text-decoration: none;
    color: var(--white);
  }
  .others a:hover h3 {
    color: var(--lime);
  }
  .others p {
    color: #c4dccd;
  }

  @media (max-width: 56rem) {
    .split,
    .others {
      grid-template-columns: 1fr;
    }
    .fridays {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 30rem) {
    .facts {
      grid-template-columns: 1fr;
    }
  }
</style>
