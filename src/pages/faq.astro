---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Closing from '../components/Closing.astro';
import { faqGroups } from '../data/site';

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const schema = {
  '@type': 'FAQPage',
  mainEntity: faqGroups.flatMap((g) =>
    g.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  ),
};
---

<Base
  title="Questions and answers"
  description="How Nimblebase works, what it costs, who owns the work and what happens to your data. Straight answers to the questions we get asked."
  schema={schema}
>
  <PageHero title="Fair questions, straight answers" lede="If yours isn't here, ask it on a call. It'll probably end up on this page.">
    <nav class="jump" aria-label="Question groups">
      {faqGroups.map((g) => <a href={`#${slug(g.title)}`}>{g.title}</a>)}
    </nav>
  </PageHero>

  <section class="band">
    <div class="wrap groups">
      {
        faqGroups.map((g) => (
          <div class="group" id={slug(g.title)}>
            <h2>{g.title}</h2>
            <Faq items={g.items} />
          </div>
        ))
      }
    </div>
  </section>

  <Closing />
</Base>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-family: var(--display);
    font-weight: 600;
  }
  .groups {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    align-items: start;
    scroll-margin-top: 2rem;
  }
  .group h2 {
    font-size: var(--t-xl);
  }
  @media (max-width: 56rem) {
    .group {
      grid-template-columns: 1fr;
    }
  }
</style>
