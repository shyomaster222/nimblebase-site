---
import Schema from './Schema.astro';

export interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', href: '/' }, ...crumbs];
const schema = {
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    item: new URL(c.href ?? Astro.url.pathname, Astro.site).href,
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => (
        <li>
          {c.href && i < trail.length - 1 ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<Schema data={schema} />

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    font-size: 0.95rem;
    color: var(--forest-soft);
  }
  li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--mint-deep);
  }
  a {
    text-underline-offset: 0.2em;
  }
  [aria-current] {
    color: var(--forest);
    font-weight: 500;
  }
</style>
