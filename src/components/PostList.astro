---
import { formatDate, readingTime, topic, type Post } from '../data/insights';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<ul class="posts">
  {
    posts.map((post) => (
      <li>
        <a href={`/insights/${post.id}/`}>
          <p class="meta">
            <span class="tag">{topic(post).label}</span>
            <span>{formatDate(post.data.date)}</span>
            <span>{readingTime(post)}</span>
          </p>
          <h3>{post.data.title}</h3>
          <p class="desc">{post.data.description}</p>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 2px solid var(--forest);
  }
  a {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
    gap: 0.75rem clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding-block: 2rem;
    border-top: 2px solid var(--forest);
    text-decoration: none;
    color: var(--forest);
    transition: background 0.15s, padding-inline 0.15s;
  }
  a:hover,
  a:focus-visible {
    background: var(--mint);
    padding-inline: 1.25rem;
  }
  .meta {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    font-size: 0.95rem;
    color: var(--forest-soft);
  }
  .tag {
    background: var(--lime);
    color: var(--forest);
    font-family: var(--display);
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 5px;
  }
  h3 {
    font-size: var(--t-lg);
    line-height: 1.12;
  }
  .desc {
    color: var(--forest-soft);
  }
  @media (max-width: 56rem) {
    a {
      grid-template-columns: 1fr;
    }
    .meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem 0.9rem;
      align-items: center;
    }
  }
</style>
