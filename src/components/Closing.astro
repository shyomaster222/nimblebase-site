---
import { site } from '../data/site';
---

<section class="band band-mint closing">
  <div class="wrap inner">
    <h2>Tell us what's stuck. We'll tell you what we'd ship first.</h2>
    <div class="cta-row">
      <a class="btn" href="/contact/">{site.cta}</a>
      <p class="cta-note">No deck and no pitch. Bring the problem and we'll work through it with you.</p>
    </div>
  </div>
</section>

<style>
  .inner {
    display: grid;
    gap: 2rem;
  }
  h2 {
    max-width: 18ch;
  }
</style>
