---
import { faqs, type Faq } from '../data/site';

interface Props {
  items?: Faq[];
}
const { items = faqs } = Astro.props;
---

<div class="faq">
  {
    items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-bottom: 2px solid var(--forest);
  }
  details {
    border-top: 2px solid var(--forest);
  }
  summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.25rem;
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--t-md);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  /* Plus that turns into a minus: shows what the control will do. */
  summary::after {
    content: '';
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.25rem;
    background:
      linear-gradient(var(--leaf), var(--leaf)) center / 100% 3px no-repeat,
      linear-gradient(var(--leaf), var(--leaf)) center / 3px 100% no-repeat;
    transition: transform 0.2s;
  }
  details[open] summary::after {
    background: linear-gradient(var(--leaf), var(--leaf)) center / 100% 3px no-repeat;
    transform: rotate(180deg);
  }
  details p {
    padding-bottom: 1.5rem;
    color: var(--forest-soft);
  }
</style>
