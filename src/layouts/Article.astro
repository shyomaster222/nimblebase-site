---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostList from '../components/PostList.astro';
import Closing from '../components/Closing.astro';
import { site } from '../data/site';
import { getPosts, formatDate, readingTime, topic, type Post } from '../data/insights';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const tag = topic(post);
const more = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 2);
const schema = {
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
  mainEntityOfPage: new URL(`/insights/${post.id}/`, Astro.site).href,
};
---

<Base title={post.data.title} description={post.data.description} schema={schema} ogType="article">
  <article>
    <header class="band-mint head">
      <div class="wrap inner">
        <Breadcrumbs crumbs={[{ label: 'Insights', href: '/insights/' }, { label: post.data.title }]} />
        <h1>{post.data.title}</h1>
        <p class="lede">{post.data.description}</p>
        <p class="meta">
          <a class="tag" href={tag.href}>{tag.label}</a>
          <span>{site.byline}</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <span>{readingTime(post)}</span>
        </p>
      </div>
    </header>

    <div class="wrap body">
      <div class="prose">
        <slot />
      </div>
      <aside>
        <h2>Want this done with you?</h2>
        <p>This is the kind of work we do in a two-week sprint. One problem, fixed price, something live each Friday.</p>
        <a class="btn" href="/contact/">{site.cta}</a>
        <a class="quiet" href={tag.href}>More about {tag.label.startsWith('AI') ? tag.label : tag.label.toLowerCase()}</a>
      </aside>
    </div>
  </article>

  <section class="band more">
    <div class="wrap">
      <div class="band-head">
        <h2>Keep reading</h2>
      </div>
      <PostList posts={more} />
    </div>
  </section>

  <Closing />
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 6vw, 5rem);
  }
  .inner {
    display: grid;
    gap: 1.5rem;
  }
  h1 {
    font-size: var(--t-2xl);
    max-width: 22ch;
  }
  .meta {
    max-width: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.25rem;
    color: var(--forest-soft);
    font-size: 0.95rem;
  }
  .tag {
    background: var(--lime);
    color: var(--forest);
    font-family: var(--display);
    font-weight: 600;
    padding: 0.05rem 0.5rem;
    border-radius: 5px;
    text-decoration: none;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 3rem clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  /* Markdown content is rendered by Astro, so these rules reach into it. */
  .prose {
    font-size: 1.1875rem;
    line-height: 1.7;
    max-width: 68ch;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote) {
    margin: 0 0 1.4em;
    max-width: none;
  }
  .prose :global(h2) {
    font-size: var(--t-lg);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 2.2em 0 0.7em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: 0.5em;
    padding-left: 0.2em;
  }
  .prose :global(li::marker) {
    color: var(--leaf);
    font-weight: 600;
  }
  .prose :global(strong) {
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--leaf-dark);
  }
  .prose :global(blockquote) {
    background: var(--mint);
    border-radius: var(--r-panel);
    padding: 1.5rem 1.75rem;
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  aside {
    position: sticky;
    top: 2rem;
    display: grid;
    gap: 1rem;
    justify-items: start;
    background: var(--forest);
    color: var(--white);
    border-radius: var(--r-panel);
    padding: clamp(1.5rem, 3vw, 2rem);
  }
  aside h2 {
    font-size: var(--t-lg);
  }
  aside p {
    color: #c4dccd;
  }
  aside .btn {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--forest);
  }
  aside .btn:hover {
    background: var(--white);
    border-color: var(--white);
  }
  aside .quiet {
    color: var(--white);
    font-size: 0.95rem;
  }
  aside .quiet:hover {
    color: var(--lime);
  }
  .more {
    padding-top: 0;
  }

  @media (max-width: 60rem) {
    .body {
      grid-template-columns: 1fr;
    }
    aside {
      position: static;
    }
  }
</style>
